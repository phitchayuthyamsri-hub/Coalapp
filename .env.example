# ---------------------------------------------------------------------------
# coalapp server config.  Copy this file to ".env" on the server (/opt/coalapp/.env)
# and fill in values.  ".env" is gitignored and must NEVER be committed.
#
# GPS ingestion stays completely OFF until a provider is BOTH enabled (=1) AND
# has its credentials filled in.  Leaving everything as-is changes nothing.
# ---------------------------------------------------------------------------

# Optional: override the Flask secret / database in production
# SECRET_KEY=
# DATABASE_URL=

# --- TCT  (POST {base}/gps/tracking) --------------------------------------
# TCT grants access via a CustomerCode + Key (see the "License" section they sent).
# The Key is a secret — keep it only here in .env, never in git or chat.
GPS_TCT_ENABLED=0
GPS_TCT_BASE_URL=http://webapi.dientutct.com/apiwba
GPS_TCT_CUSTOMER_CODE=
GPS_TCT_KEY=
# How CustomerCode + Key are passed. If the first pull says "Access Denied",
# try switching:  body (default)  |  header
GPS_TCT_AUTH_MODE=body
# Which timestamp to store as the ping time:  LocalTime (UTC+7)  or  UTCTime
GPS_TCT_TS_FIELD=LocalTime
# Trial plates, comma-separated.  Leave blank to capture every authorised vehicle.
GPS_TCT_PLATES=

# --- Adsun ShareAPI  (REST) -----------------------------------------------
# (connector is a stub until Adsun sends the ShareAPI docs + credentials)
GPS_ADSUN_ENABLED=0
GPS_ADSUN_BASE_URL=
GPS_ADSUN_TOKEN=
GPS_ADSUN_PLATES=
